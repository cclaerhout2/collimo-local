# Copier ce fichier en .env.local et le compléter (ne jamais le committer).

# Identifiant client OAuth « Collimo – Web » (type Application Web)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Clé API « Collimo – Picker », limitée à l'API Picker et à l'adresse du site
VITE_GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Numéro du projet GCP (sert d'appId au sélecteur Google Picker)
VITE_GOOGLE_APP_ID=123456789012

# Domaine Workspace autorisé (ex. entreprise.com). Vide = pas de contrôle côté app.
VITE_ALLOWED_DOMAIN=

# 1 = mode démo avec un Drive simulé, sans compte Google (développement uniquement)
VITE_MOCK=0
