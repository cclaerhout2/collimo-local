{
  "name": "collimo",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "oxlint src electron && prettier --check \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"tools/**/*.mjs\"",
    "gen:assets": "node tools/gen-assets.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"electron/**/*.ts\" \"tools/**/*.mjs\"",
    "desktop:build": "vite build && node tools/build-electron.mjs",
    "desktop:start": "npm run desktop:build && electron .",
    "desktop:pack": "npm run desktop:build && electron-builder --publish never",
    "test:e2e": "node tools/e2e-desktop.mjs",
    "desktop:pack:win": "npm run desktop:build && electron-builder --win --x64 --publish never",
    "desktop:pack:mac": "npm run desktop:build && electron-builder --mac --publish never",
    "desktop:pack:linux": "npm run desktop:build && electron-builder --linux --x64 --publish never",
    "android:sync": "vite build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew --no-daemon assembleRelease",
    "test:e2e:android": "node tools/e2e-android.mjs",
    "web:build": "vite build --mode localweb --outDir dist-web",
    "test:e2e:web": "node tools/e2e-web.mjs",
    "ios:sync": "vite build && cap sync ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "heic-to": "^1.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/ph": "^1.2.2",
    "@phosphor-icons/core": "^2.1.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "google-fonts-complete": "^2.2.3",
    "image-size": "^2.1.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "description": "Collimo pour ordinateur et Android : collages photo à partir des dossiers de l’appareil (Electron, Capacitor).",
  "author": {
    "name": "Cédric Claerhout",
    "email": "cclaerhout2@users.noreply.github.com"
  },
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "fr.collimo.app",
    "productName": "Collimo",
    "copyright": "Cédric Claerhout",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico",
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}",
      "legalTrademarks": "Collimo"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Collimo",
      "installerLanguages": [
        "fr_FR",
        "en_US"
      ],
      "language": "1036",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "electronLanguages": [
      "fr",
      "en-US",
      "en-GB",
      "en"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.icns",
      "category": "public.app-category.photography",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Collimo ${version}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.png",
      "category": "Graphics",
      "synopsis": "Collages photo à partir des dossiers de l’ordinateur",
      "maintainer": "Cédric Claerhout <cclaerhout2@users.noreply.github.com>",
      "executableName": "collimo",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "syncDesktopName": true
    },
    "deb": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cclaerhout2/collimo-local.git"
  },
  "homepage": "https://github.com/cclaerhout2/collimo-local",
  "desktopName": "collimo.desktop"
}
