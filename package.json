{
  "name": "collimo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "oxlint src && prettier --check \"src/**/*.{ts,tsx,css}\" \"tools/**/*.mjs\"",
    "preview": "vite preview",
    "deploy:preview": "npm run build && firebase hosting:channel:deploy test --only collimo",
    "deploy": "npm run build && firebase deploy --only hosting:collimo",
    "gen:assets": "node tools/gen-assets.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tools/**/*.mjs\""
  },
  "dependencies": {
    "heic-to": "^1.6.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@iconify-json/fluent-emoji-flat": "^1.2.6",
    "@iconify-json/ph": "^1.2.2",
    "@phosphor-icons/core": "^2.1.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "google-fonts-complete": "^2.2.3",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
